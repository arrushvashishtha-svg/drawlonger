# Copy this to .env for local testing. On Render, set these in the
# Environment tab instead — don't upload a real .env file to GitHub.

PORT=3000

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# From your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
